---
permalink: "/feed.xml"
eleventyExcludeFromCollections: true
metadata:
  title: "EZT blog"
  description: "Personal blog of Zhargal Erdyneev."
  base: "https://happytrip.cc"   # без завершающего слэша
  language: "ru-RU"
  author:
    name: "Zhargal Erdyneev"
---

{{- '<?xml version="1.0" encoding="utf-8"?>' | safe }}
<rss version="2.0">
  <channel>
    <title>{{ metadata.title }}</title>
    <link>{{ metadata.base }}/</link>
    <description>{{ metadata.description }}</description>
    <language>{{ metadata.language }}</language>

    {% if collections.post and collections.post | length %}
      <lastBuildDate>{{ (collections.post | last).date | dateToRfc822 }}</lastBuildDate>
    {% endif %}

    {% for post in collections.post | reverse %}
      {% set abs = post.url | htmlBaseUrl(metadata.base) %}
      {% set raw = post.data.excerpt or post.templateContent %}
      {# Готовим безопасное текстовое описание #}
      {% set text = raw | striptags | trim %}

      <item>
        <title>{{ post.data.title | safe }}</title>
        <link>{{ abs }}</link>
        <guid>{{ abs }}</guid>
        <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
        <description>{{ text | escape }}</description>
      </item>
    {% endfor %}
  </channel>
</rss>